{
  "name": "iapetus",
  "workspaces": [
    "packages/*"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "clean": "yarn run lerna clean -y && rm -rf node_modules",
    "build": "yarn run lerna run build --concurrency 2",
    "reinstall": "yarn clean && yarn && yarn run lerna exec yarn --concurrency 1",
    "start": "yarn run nodemon --watch ./**/src -e '.ts' --exec 'yarn run lerna run build'",
    "prerelease": "yarn run lerna publish prerelease -y",
    "upgrade:all": "yarn up -E \"@*/*\" -i && yarn up -E \"*\" -i",
    "upgrade:atlaskit": "yarn up -E \"@atlaskit/*\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "eslint": "10.12.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "lerna": "10.0.1",
    "node-gyp": "13.1.0",
    "nodemon": "3.1.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "resolutions": {
    "@types/express": "5.0.6"
  },
  "packageManager": "yarn@4.0.2"
}
