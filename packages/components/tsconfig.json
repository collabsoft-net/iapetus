{
  "compilerOptions": {
    "target": "es2019",
    "lib": [
      "dom",
      "es2015",
      "es2017"
    ],
    "module": "es2020",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "jsx": "react",
    "strict": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "./typings/*.d.ts",
    "./typings/**/*.d.ts",
    "../node_modules/@collabsoft-net/**/*.d.ts"
  ],
  "compileOnSave": false
}
