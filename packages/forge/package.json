{
  "name": "@collabsoft-net/forge",
  "version": "1.1.2-alpha.207",
  "description": "Client-side helper functions for Atlassian Forge",
  "author": "CollabSoft <info@collabsoft.net>",
  "homepage": "https://github.com/collabsoft-net/iapetus#readme",
  "license": "Apache-2.0",
  "sideEffects": false,
  "module": "./dist/es2020/index.js",
  "main": "./dist/cjs/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/collabsoft-net/iapetus.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "lint": "yarn run eslint",
    "build": "yarn clean && yarn lint && yarn build:cjs && yarn build:es2020 && yarn build:types",
    "build:cjs": "yarn run tsc --module commonjs --outDir dist/cjs",
    "build:es2020": "yarn run tsc --module es2020 --outDir dist/es2020",
    "build:types": "yarn run tsc --emitDeclarationOnly --outDir dist/types",
    "start": "yarn run nodemon --watch src -e '.ts' --exec 'yarn build'",
    "prepack": "yarn build"
  },
  "exports": {
    "./backend": {
      "types": "./dist/types/backend/index.d.ts",
      "require": "./dist/cjs/backend/index.js",
      "import": "./dist/es2020/backend/index.js"
    },
    "./frontend": {
      "types": "./dist/types/frontend/index.d.ts",
      "require": "./dist/cjs/frontend/index.js",
      "import": "./dist/es2020/frontend/index.js"
    },
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/es2020/index.js"
    }
  },
  "bugs": {
    "url": "https://github.com/collabsoft-net/iapetus/issues"
  },
  "devDependencies": {
    "@forge/bridge": "4.4.1",
    "@types/node": "<19.0.0",
    "@typescript-eslint/eslint-plugin": "6.19.1",
    "@typescript-eslint/parser": "6.19.1",
    "eslint": "8.56.0",
    "nodemon": "3.0.3",
    "typescript": "5.3.3"
  },
  "peerDependencies": {
    "@forge/bridge": "4.4.1"
  },
  "gitHead": "90588ca94d4036648c49a76557e532e385259578"
}
