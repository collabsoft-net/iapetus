{
  "name": "@collabsoft-net/repositories",
  "version": "1.1.2-alpha.279",
  "description": "Implementations of supported repositories",
  "author": "CollabSoft <info@collabsoft.net>",
  "homepage": "https://github.com/collabsoft-net/iapetus#readme",
  "license": "Apache-2.0",
  "sideEffects": false,
  "module": "./dist/es2020/server/index.js",
  "main": "./dist/cjs/server/index.js",
  "types": "./dist/types/server/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/collabsoft-net/iapetus.git"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    "./MemoryRepository": {
      "types": "./dist/types/MemoryRepository.d.ts",
      "require": "./dist/cjs/MemoryRepository.js",
      "import": "./dist/es2020/MemoryRepository.js"
    },
    "./QueryBuilder": {
      "types": "./dist/types/QueryBuilder.d.ts",
      "require": "./dist/cjs/QueryBuilder.js",
      "import": "./dist/es2020/QueryBuilder.js"
    },
    "./client/FirebaseRepository": {
      "types": "./dist/types/client/FirebaseRepository.d.ts",
      "require": "./dist/cjs/client/FirebaseRepository.js",
      "import": "./dist/es2020/client/FirebaseRepository.js"
    },
    "./server/CachedFirebaseAdminRepository": {
      "types": "./dist/types/server/CachedFirebaseAdminRepository.d.ts",
      "require": "./dist/cjs/server/CachedFirebaseAdminRepository.js",
      "import": "./dist/es2020/server/CachedFirebaseAdminRepository.js"
    },
    "./server/FirebaseAdminRepository": {
      "types": "./dist/types/server/FirebaseAdminRepository.d.ts",
      "require": "./dist/cjs/server/FirebaseAdminRepository.js",
      "import": "./dist/es2020/server/FirebaseAdminRepository.js"
    },
    "./server/FirebaseAdminStorageProvider": {
      "types": "./dist/types/server/FirebaseAdminStorageProvider.d.ts",
      "require": "./dist/cjs/server/FirebaseAdminStorageProvider.js",
      "import": "./dist/es2020/server/FirebaseAdminStorageProvider.js"
    },
    "./server/ForgeRepository": {
      "types": "./dist/types/server/ForgeRepository.d.ts",
      "require": "./dist/cjs/server/ForgeRepository.js",
      "import": "./dist/es2020/server/ForgeRepository.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "lint": "yarn run eslint",
    "build": "yarn clean && yarn lint && yarn build:cjs && yarn build:es2020 && yarn build:types",
    "build:cjs": "yarn run tsc --module commonjs --outDir dist/cjs",
    "build:es2020": "yarn run tsc --module es2020 --outDir dist/es2020",
    "build:types": "yarn run tsc --emitDeclarationOnly --outDir dist/types",
    "start": "yarn run nodemon --watch src -e '.ts' --exec 'yarn build'",
    "prepack": "yarn build",
    "preinstall": "echo Installing dependencies for @collabsoft-net/repositories"
  },
  "bugs": {
    "url": "https://github.com/collabsoft-net/iapetus/issues"
  },
  "devDependencies": {
    "@collabsoft-net/dto": "workspace:*",
    "@collabsoft-net/emitters": "workspace:*",
    "@collabsoft-net/types": "workspace:*",
    "@forge/kvs": "1.0.6",
    "@google-cloud/storage": "7.16.0",
    "@types/node": "<19.0.0",
    "@types/uniqid": "5.3.4",
    "@typescript-eslint/eslint-plugin": "8.32.0",
    "@typescript-eslint/parser": "8.32.0",
    "eslint": "9.26.0",
    "firebase": "11.7.1",
    "firebase-admin": "13.3.0",
    "nodemon": "3.1.10",
    "typescript": "5.8.3",
    "uniqid": "5.4.0"
  },
  "peerDependencies": {
    "@collabsoft-net/dto": "*",
    "@collabsoft-net/emitters": "*",
    "@forge/kvs": "*",
    "@google-cloud/storage": "^7.16.0",
    "firebase": "^11.7.0",
    "firebase-admin": "^13.3.0",
    "uniqid": "^5.4.0"
  },
  "gitHead": "90588ca94d4036648c49a76557e532e385259578"
}
