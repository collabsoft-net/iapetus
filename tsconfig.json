{
  "compilerOptions": {
    "target": "es2019",
    "lib": [
      "dom",
      "es2022",
    ],
    "module": "es2020",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "declaration": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "preserve",
    "jsxFactory": "h",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
  },
  "include": [
    "./typings/*.d.ts",
    "./typings/**/*.d.ts",
    "./node_modules/@types/**/*.d.ts"
  ],
  "compileOnSave": false
}
